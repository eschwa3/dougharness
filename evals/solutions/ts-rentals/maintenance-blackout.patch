+/** The bookings of one item that collide with a span. Inspection windows count as bookings: an item in the workshop is not free. */
+export function conflictsFor(bookings: Booking[], itemId: string, span: Span, windows: Booking[] = []): Booking[] {
+  return [...bookings, ...windows].filter((booking) => booking.itemId === itemId && overlaps(booking, span));
 }
 
