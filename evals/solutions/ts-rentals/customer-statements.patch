+import type { Item } from "../catalog/item.js";
+import type { Customer } from "../customers/customer.js";
+import { netReceivedInMonth } from "../payments/ledger.js";
+import type { Ledger } from "../payments/ledger.js";
+import { billableDays, rentalCostCents } from "../pricing/rates.js";
+import type { Reservation } from "../reservations/reservation.js";
+import { sumCents } from "../util/money.js";
+import type { Cents } from "../util/money.js";
+import { pluralise } from "../util/text.js";
+
+export interface StatementLine {
+  reservationId: string;
+  label: string;
+  cents: Cents;
+}
+
+export interface Statement {
+  customerId: string;
+  /** The month the statement covers, "2025-03". */
+  month: string;
+  lines: StatementLine[];
+  chargesCents: Cents;
+  /** Payments received in the month less refunds paid in it. */
+  receivedCents: Cents;
+  balanceCents: Cents;
+}
+
+/** The monthly statement of one customer: the rentals that start in the month, less what was received in it. */
+export function statementFor(customer: Customer, reservations: Reservation[], items: Item[], ledger: Ledger, month: string): Statement {
+  const mine = reservations.filter((r) => r.customerId === customer.id);
+  const lines: StatementLine[] = [];
+  for (const reservation of mine) {
+    if (reservation.status === "cancelled" || reservation.start.slice(0, 7) !== month) continue;
+    const item = items.find((i) => i.id === reservation.itemId);
+    if (!item) continue;
+    const days = billableDays(reservation.start, reservation.end);
+    lines.push({ reservationId: reservation.id, label: `${item.name}, ${pluralise(days, "day")}`, cents: rentalCostCents(item, days) });
+  }
+  const chargesCents = sumCents(lines.map((line) => line.cents));
+  const receivedCents = netReceivedInMonth(
+    ledger,
+    mine.map((r) => r.id),
+    month,
+  );
+  return { customerId: customer.id, month, lines, chargesCents, receivedCents, balanceCents: chargesCents - receivedCents };
+}
