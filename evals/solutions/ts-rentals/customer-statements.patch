+describe("statement", () => {
+  const items = seedCatalog();
+  const bo = makeCustomer({ id: "cus-0002", name: "Bo", email: "bo@example.com" });
+  const rent = (id: string, customerId: string, itemIndex: number, start: string, end: string) =>
+    createReservation({ id, item: items[itemIndex], customerId, start, end }, []);
+  const march = rent("res-0101", "cus-0001", 0, "2025-03-10", "2025-03-13");
+  const marchSaw = rent("res-0102", "cus-0001", 1, "2025-03-20", "2025-03-22");
+  const april = rent("res-0103", "cus-0001", 0, "2025-04-02", "2025-04-04");
+  const others = rent("res-0104", "cus-0002", 2, "2025-03-11", "2025-03-12");
+  const pay = (id: string, reservationId: string, cents: number, day: string): Payment => ({ id, reservationId, cents, kind: "payment", day });
+  const ledger: Payment[] = [pay("pay-1", "res-0101", 2000, "2025-03-12"), pay("pay-2", "res-0103", 3000, "2025-04-02")];
+
+  it("charges each rental that starts in the month", () => {
+    const s = statementFor(ana, [march, marchSaw, april, others], items, ledger, "2025-03");
+    expect(s.lines).toEqual([
+      { reservationId: "res-0101", label: "Cordless drill, 3 days", cents: 4500 },
+      { reservationId: "res-0102", label: "Tile saw, 2 days", cents: 8000 },
+    ]);
+    expect(s.chargesCents).toBe(12500);
+  });
+  it("leaves out cancelled rentals and rentals of other customers", () => {
+    const s = statementFor(ana, [cancel(march), marchSaw, others], items, ledger, "2025-03");
+    expect(s.lines.map((l) => l.reservationId)).toEqual(["res-0102"]);
+    expect(statementFor(bo, [march, others], items, ledger, "2025-03").lines.map((l) => l.reservationId)).toEqual(["res-0104"]);
+  });
+  it("takes the payments received in the month, net of refunds, off the charges", () => {
+    const refund: Payment = { id: "pay-3", reservationId: "res-0101", cents: 500, kind: "refund", day: "2025-03-14" };
+    const s = statementFor(ana, [march, marchSaw, april], items, [...ledger, refund], "2025-03");
+    expect(s.receivedCents).toBe(1500);
+    expect(s.balanceCents).toBe(12500 - 1500);
+  });
+  it("is empty for a month with no rentals", () => {
+    expect(statementFor(ana, [march], items, [], "2025-05")).toMatchObject({ lines: [], chargesCents: 0, receivedCents: 0, balanceCents: 0 });
+  });
+});
