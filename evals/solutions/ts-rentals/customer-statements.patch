diff --git a/src/payments/ledger.ts b/src/payments/ledger.ts
index e3e768d..a70c0f4 100644
--- a/src/payments/ledger.ts
+++ b/src/payments/ledger.ts
@@ -47,3 +47,12 @@ export function refundedCents(ledger: Ledger, reservationId: string): Cents {
 export function netPaidCents(ledger: Ledger, reservationId: string): Cents {
   return paidCents(ledger, reservationId) - refundedCents(ledger, reservationId);
 }
+
+/** Money kept in a month over some reservations: payments less refunds dated in that month ("2025-03"). */
+export function netReceivedInMonth(ledger: Ledger, reservationIds: string[], month: string): Cents {
+  return sumCents(
+    ledger
+      .filter((p) => reservationIds.includes(p.reservationId) && p.day.slice(0, 7) === month)
+      .map((p) => (p.kind === "payment" ? p.cents : -p.cents)),
+  );
+}
