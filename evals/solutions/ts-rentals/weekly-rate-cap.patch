-/** The rental charge for a number of days at the item's day rate. */
+/** Days in a rental week. */
+export const DAYS_PER_WEEK = 7;
+
+/** The rental charge for a number of days: each full week costs the weekly rate, and the days left over never cost more than one weekly rate. */
 export function rentalCostCents(item: Item, days: number): Cents {
-  return item.dayRateCents * days;
+  const weeks = Math.floor(days / DAYS_PER_WEEK);
+  const leftover = days - weeks * DAYS_PER_WEEK;
+  return weeks * item.weekRateCents + Math.min(leftover * item.dayRateCents, item.weekRateCents);
 }
 
 /** The rental charge for a pickup and due day. */
