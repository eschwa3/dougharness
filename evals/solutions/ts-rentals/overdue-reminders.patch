+  contact?: Contact;
 }
 
 /** Checks a customer record and returns it. A new customer is a standard customer unless said otherwise. */
@@ -23,9 +28,16 @@ export function makeCustomer(input: CustomerInput): Customer {
   if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(input.email)) throw new Error(`customer ${input.id} has a bad email`);
   const customer: Customer = { id: input.id, name: input.name.trim(), email: input.email, tier: input.tier ?? "standard" };
   if (input.phone) customer.phone = input.phone;
+  if (input.contact === "phone" && !input.phone) throw new Error(`customer ${input.id} prefers phone but has no phone number`);
+  if (input.contact) customer.contact = input.contact;
   return customer;
 }
 
+/** Where to reach a customer: the phone number when they prefer phone, otherwise the email address. */
+export function contactAddress(customer: Customer): string {
