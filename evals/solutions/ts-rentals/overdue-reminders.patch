 import type { Item } from "../catalog/item.js";
 import type { Customer } from "../customers/customer.js";
-import { findCustomer } from "../customers/customer.js";
+import { contactAddress, findCustomer } from "../customers/customer.js";
+import { memberGraceDays } from "../customers/membership.js";
 import type { Reservation } from "../reservations/reservation.js";
+import { isOverdue } from "../reservations/status.js";
 import { addDays } from "../util/dates.js";
 import type { Day } from "../util/dates.js";
+import { fill } from "../util/text.js";
 import { render, subjectFor } from "./templates.js";
 
 export interface Reminder {
@@ -35,3 +38,23 @@ export function pickupReminders(reservations: Reservation[], customers: Customer
   }
   return reminders;
 }
+
+const OVERDUE_BODY = "Hello {name}, your {item} was due back on {end}. Please bring it back.";
+
+/** An overdue reminder for each rental still out past its due day and the customer's grace days, sent where the customer prefers. */
+export function overdueReminders(reservations: Reservation[], customers: Customer[], items: Item[], today: Day): Reminder[] {
+  const reminders: Reminder[] = [];
+  for (const reservation of reservations) {
+    const customer = findCustomer(customers, reservation.customerId);
+    const item = items.find((i) => i.id === reservation.itemId);
+    if (!customer || !item) continue;
+    if (!isOverdue(reservation.status, reservation.end, today, memberGraceDays(customer))) continue;
+    reminders.push({
+      reservationId: reservation.id,
+      to: contactAddress(customer),
+      subject: "Rental overdue",
+      body: fill(OVERDUE_BODY, { name: customer.name, item: item.name, end: reservation.end }),
+    });
+  }
+  return reminders;
+}
