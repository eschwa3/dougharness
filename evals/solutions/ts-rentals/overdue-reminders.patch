+import { daysBetween } from "../util/dates.js";
+import type { Day } from "../util/dates.js";
+
 export type Status = "requested" | "confirmed" | "picked-up" | "returned" | "cancelled";
 
 const TRANSITIONS: Record<Status, Status[]> = {
@@ -27,3 +30,8 @@ export function isFinal(status: Status): boolean {
 export function holdsItem(status: Status): boolean {
   return status === "requested" || status === "confirmed" || status === "picked-up";
 }
+
+/** True for an item still out once `graceDays` have passed after its due day. */
+export function isOverdue(status: Status, end: Day, today: Day, graceDays = 0): boolean {
+  return status === "picked-up" && daysBetween(end, today) > graceDays;
+}
