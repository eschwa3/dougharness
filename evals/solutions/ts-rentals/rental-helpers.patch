+
+/** True when an item is due for an inspection on `today`: never inspected, or its interval since the last one has run out. */
+export function dueForInspection(log: Inspection[], item: Item, today: Day): boolean {
+  const last = lastInspectionDay(log, item.id);
+  if (last === undefined) return true;
+  return compareDays(nextInspectionDay(item, last), today) <= 0;
