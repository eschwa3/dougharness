 export function netPaidCents(ledger: Ledger, reservationId: string): Cents {
   return paidCents(ledger, reservationId) - refundedCents(ledger, reservationId);
 }
+
+/** What a customer still owes on a reservation, given the amount due: the amount less what was kept, never below zero. */
+export function openBalance(ledger: Ledger, reservationId: string, dueCents: Cents): Cents {
+  return Math.max(0, dueCents - netPaidCents(ledger, reservationId));
+}
