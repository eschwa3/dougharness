+import type { Reservation } from "../reservations/reservation.js";
 import { addDays, compareDays, daysBetween } from "../util/dates.js";
 import type { Day } from "../util/dates.js";
 
@@ -24,3 +25,14 @@ export function nextRange(range: DateRange): DateRange {
   const length = rangeDays(range);
   return { from: range.to, to: addDays(range.to, length) };
 }
+
+/** Booked days per item inside a range. Cancelled reservations book nothing, and an item with no booked days is left out. */
+export function bookedDaysByItem(reservations: Reservation[], range: DateRange): Record<string, number> {
+  const booked: Record<string, number> = {};
+  for (const reservation of reservations) {
+    if (reservation.status === "cancelled") continue;
+    const days = sharedDays(reservation, range);
+    if (days > 0) booked[reservation.itemId] = (booked[reservation.itemId] ?? 0) + days;
+  }
+  return booked;
+}
