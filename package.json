{
  "name": "dougharness",
  "private": true,
  "version": "1.6.0",
  "description": "Doug: a native-first harness for Claude Code. Deterministic gates, tailored install, honest memory.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.16"
  },
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "sh scripts/setup.sh",
    "build": "pnpm -r --filter \"./packages/*\" run build && pnpm hooks:sync && pnpm workflows:sync",
    "workflows:sync": "node scripts/sync-card-loop.mjs",
    "hooks:sync": "node scripts/sync-hooks.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/codex-live.test.ts' --exclude 'tests/rehearse-replay.test.mjs' --exclude 'tests/e2e-journey.test.mjs' --exclude 'tests/rehearse-auto.test.mjs' --exclude 'tests/rehearse-scenarios.test.mjs' --exclude 'tests/rehearse-fixture-rentals.test.mjs' --exclude 'tests/rehearse-fixture-orders.test.mjs' --exclude 'tests/rehearse-hard-tier.test.mjs' --exclude 'tests/rehearse-hard-assert.test.mjs' --exclude 'tests/rehearse.test.mjs'",
    "test:rehearse": "vitest run tests/rehearse-auto.test.mjs tests/rehearse-scenarios.test.mjs tests/rehearse-fixture-rentals.test.mjs tests/rehearse-fixture-orders.test.mjs tests/rehearse-hard-tier.test.mjs tests/rehearse-hard-assert.test.mjs tests/rehearse.test.mjs",
    "test:e2e": "vitest run tests/rehearse-replay.test.mjs tests/e2e-journey.test.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "eval": "node evals/run.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "release:check": "node scripts/release.mjs check",
    "release:stage": "node scripts/release.mjs stage"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
