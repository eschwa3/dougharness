#!/bin/sh
# Rebuild packages/doug-cli's dist after a merge or pull that brought in its sources (card
# cli-dist-rebuild-post-commit). Never blocks or changes the merge: every path exits 0. Does nothing in a
# linked worktree.
set -u

cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

git_dir=$(cd "$(git rev-parse --git-dir 2>/dev/null)" 2>/dev/null && pwd -P) || exit 0
common_dir=$(cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P) || exit 0
[ "$git_dir" = "$common_dir" ] || exit 0

paths=$(git -c core.quotePath=false diff --name-only --no-renames ORIG_HEAD HEAD 2>/dev/null) || exit 0

printf '%s\n' "$paths" | sh "$(dirname "$0")/rebuild-dist"
exit 0
